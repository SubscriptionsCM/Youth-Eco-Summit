APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://yes:local-development-only@localhost:5432/yes
DATABASE_SSL=false
# Remote PostgreSQL connections require verified TLS and the server CA.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3
MIGRATION_DATABASE_URL=
# Keep the reference forms disabled until staging acceptance and account migration.
PORTAL_REFERENCE_FORMS=false
AUTH_PARTICIPANT_PROVIDER=native
SUBSCRIPTION_CONTACT_EMAIL=subscriptions@compactummedia.com
# Generate a random secret of at least 32 characters. Never use this file as a secret store.
AUTH_SECRET=
AUTH_DELIVERY_ENABLED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Existing Hostinger hosting transport; no mailbox or subscription is created.
EMAIL_TRANSPORT=hostinger
SENDMAIL_PATH=/srv/youth-eco-summit/config/hostinger-mail/sendmail
MAIL_FROM=noreply@youthecosummit.com
MAIL_TEMP_ROOT=/srv/youth-eco-summit/tmp/mail
# SMTP is also used by the isolated loopback acceptance-test capture server.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TEST_MODE=false
# Only set if the trusted reverse proxy overwrites this header.
AUTH_TRUSTED_IP_HEADER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SDK default credential chain; prefer a workload role in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_PROVIDER=filesystem
STORAGE_LOCAL_ROOT=
FILE_SCAN_COMMAND=
FILE_SCAN_DATABASE=
FILE_SCAN_UPDATE_COMMAND=
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
FILE_SCAN_TIMEOUT_MS=600000
# Never enable in production; scanner is required for production files.
APP_ENV=development
STORAGE_DEV_SKIP_SCAN=false
BOOTSTRAP_OWNER_CONTACT=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Worker guideline inspection: install Poppler and FFmpeg on the worker host.
# Leave blank to resolve pdftotext and ffprobe from PATH.
PDFTOTEXT_PATH=
FFPROBE_PATH=

# Match the live WordPress manual staff-review workflow. Rebuild to change.
NEXT_PUBLIC_JUDGING_MODE=manual
