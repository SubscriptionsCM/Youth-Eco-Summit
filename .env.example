APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://yes:local-development-only@localhost:5432/yes
DATABASE_SSL=false
# For Supabase: verified TLS, the dashboard CA certificate, and a small pool.
# Use the session pooler for migration/worker and transaction pooler for Vercel.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3
MIGRATION_DATABASE_URL=
# Keep the reference forms disabled until staging acceptance and account migration.
PORTAL_REFERENCE_FORMS=false
AUTH_PARTICIPANT_PROVIDER=legacy
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only needed by the private archive-transfer CLI. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=yes-private
SUBSCRIPTION_CONTACT_EMAIL=subscriptions@compactummedia.com
# Generate a random secret of at least 32 characters. Never use this file as a secret store.
AUTH_SECRET=
AUTH_DELIVERY_ENABLED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Only set if the trusted reverse proxy overwrites this header.
AUTH_TRUSTED_IP_HEADER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SDK default credential chain; prefer a workload role in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
FILE_SCAN_TIMEOUT_MS=600000
# Never enable in production; scanner is required for production files.
APP_ENV=development
STORAGE_DEV_SKIP_SCAN=false
BOOTSTRAP_OWNER_CONTACT=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Worker guideline inspection: install Poppler and FFmpeg on the worker host.
# Leave blank to resolve pdftotext and ffprobe from PATH.
PDFTOTEXT_PATH=
FFPROBE_PATH=

# Match the live WordPress manual staff-review workflow. Rebuild to change.
NEXT_PUBLIC_JUDGING_MODE=manual
